# Copie este arquivo para ".env.local" e preencha com os dados reais da empresa.

# Mercado Pago (Checkout Pro) - necessário para pagamentos reais (Pix, cartão, boleto)
# Crie uma conta em https://www.mercadopago.com.br/developers e gere um Access Token de produção.
MERCADOPAGO_ACCESS_TOKEN=

# URL pública do site em produção (usada para gerar links de retorno do pagamento)
NEXT_PUBLIC_SITE_URL=https://julilarmoveis.com

# Contato
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000
NEXT_PUBLIC_CONTACT_EMAIL=contato@julilarmoveis.com
