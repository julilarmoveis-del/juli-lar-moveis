# URL pública oficial da loja
NEXT_PUBLIC_SITE_URL=https://www.julilarofertas.com

# Contato público. Use o formato 55 + DDD + número, somente dígitos.
# Enquanto estiver vazio, os botões de WhatsApp permanecem ocultos.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=contato@julilarmoveis.com

# Checkout — manter desativado até concluir pagamento, frete e testes finais.
CHECKOUT_ENABLED=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Mercado Pago Checkout Pro — preencher somente na etapa final.
# Nunca publique um Access Token no GitHub ou em código visível ao navegador.
MERCADOPAGO_ACCESS_TOKEN=
